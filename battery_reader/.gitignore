# Flutter/Dart/Pub — build outputs and caches only.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# IDE / misc
*.iml
.idea/
.metadata

# NOTE: the platform folders (android/, ios/, windows/, ...) ARE tracked — they
# hold essential hand-edited config (BLE + notification permissions, the
# foreground-service declaration, gradle desugaring / NDK version, the Windows
# runner). Only each platform's BUILD OUTPUTS are ignored, via its own nested
# .gitignore (android/.gitignore, windows/.gitignore, ...). pubspec.lock is
# tracked (this is an application) for reproducible builds.
