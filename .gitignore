# Project-specific ignores; Flutter/Python basics are in the root .gitignore.

# APK analysis: apktool/ and unpacked-base/ are regenerable from raw/.
artifacts/*/apktool/
artifacts/*/unpacked-base/
# Competitor APK evidence (heavy; kept locally).
artifacts/_comparison/

# Captured data / logs.
python_ble/logs/
logs/
*.db
*.db-journal
*.db-wal
*.db-shm

# Flutter / IDE.
.metadata
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Flutter build output (the snapshot has no root .gitignore to carry these).
.dart_tool/
build/
