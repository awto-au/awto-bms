# Normalize all text to LF in the repo; stop the CRLF checkout warnings on Windows.
* text=auto eol=lf
# Binaries: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.xapk binary
*.dex binary
*.so binary
*.jar binary
*.keystore binary
*.ttf binary
*.otf binary
*.db binary
